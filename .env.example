PORT=3000
DEBUG=false
HTTPS_PROXY=http://localhost:7890

# OpenTelemetry 配置（可选，默认关闭）
# OTEL_ENABLED=false
# OTEL_ENDPOINT=127.0.0.1:4317
# OTEL_SERVICE_NAME=one-api
# OTEL_TRACES_ENABLED=true
# OTEL_METRICS_ENABLED=true
# OTEL_LOGS_ENABLED=true
# ====== 日志轮转 (lumberjack) ======
# 默认行为：日志自动写入 ./logs/oneapi.log 并按大小/时间轮转，无需额外配置。
# 可通过以下环境变量调优轮转策略：
#   LOG_MAX_SIZE_MB   - 单个日志文件最大字节数（MB），达到后轮转，默认 100
#   LOG_MAX_BACKUPS   - 保留的轮转文件数量，默认 7
#   LOG_MAX_AGE_DAYS  - 轮转文件最长保留天数，默认 30
#   LOG_COMPRESS      - 是否 gzip 压缩轮转文件，默认 true
#   LOG_TO_STDOUT_ONLY - 设为 1 时只输出到 stdout/stderr，不写文件（默认 false）

# ====== Agent install serving ======
# 设为非空目录路径时, one-api 会在公开路由 /agent-install/* (无需登录)
# 以静态文件方式 serve 该目录的内容。配合仓库自带的 agent-install/install.sh,
# 任意一台联网机器执行
#
#   curl -fsSL http://<host>:<port>/agent-install/install.sh | \
#       ONEAPI_BASE_URL=http://<host>:<port> bash
#
# 即可拉起 codex + one-api 的 profile。目录不存在/不可读时启动期优雅跳过,
# 不会 panic。
#
# 默认值: ./agent-install (仓库自带 install.sh / MANIFEST)。
# 设为空字符串可彻底关闭此特性。
# AGENT_INSTALL_DIR=./agent-install
